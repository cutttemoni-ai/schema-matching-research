# Local C web entry point uses config/gcp_research_v1.json. No keys required.
GOOGLE_CLOUD_PROJECT=schema-match-gemini-261103
GOOGLE_CLOUD_LOCATION=global
# Leave SERVICE_BUCKET unset for local per-session storage under runs/.
# Application call/cost caps are disabled in config/usage_policy_v2.json.
# Optional demo mode: a salted password hash in private server storage.
# No username/password is embedded in this file or in the browser bundle.
DEMO_LOGIN_ONLY=false
DEMO_CREDENTIALS_OBJECT=review-v2/config/demo-login.json
