GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# 단가를 직접 확인한 경우에만 입력. 비어 있으면 비용 미산정.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
PRICE_CURRENCY=USD
LLM_PROVIDER=azure_vm
AZURE_VM_NAME=schema-match-llm-vm
AZURE_VM_RESOURCE_GROUP=schema-match-demo-rg
AZURE_VM_LOCATION=eastasia
AZURE_VM_TIMEOUT_SECONDS=600
OLLAMA_MODEL=qwen3:4b
OLLAMA_ENDPOINT=http://127.0.0.1:11434
LOCAL_TIMEOUT_SECONDS=180
# Same Qwen/VM. baseline_v2 + cli reproduce the original path.
MATCHING_PRESET=compact_v1
AZURE_VM_TRANSPORT=rest
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR-ACTUAL-DEPLOYMENT
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=
# LLM_PROVIDER=vertex 선택 시 아래 설정 사용
